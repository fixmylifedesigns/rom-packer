<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="14dp"
                android:contentDescription="ROM Packer"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROM Packer"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Turn a game file into an installable app"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <Button
                android:id="@+id/checkUpdate"
                style="@style/GhostButton"
                android:layout_width="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Update" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/tile_violet"
                android:gravity="center"
                android:text="GB"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Game file"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/romInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:text="No ROM selected"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/romMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pick a .gb, .gbc or .gba file"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/pickRom"
                style="@style/GhostButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Choose" />
        </LinearLayout>

        <com.fixmylife.rompacker.IconCropView
            android:id="@+id/iconCrop"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pickIcon"
                style="@style/OutlineButton"
                android:layout_width="0dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:text="Image" />

            <Button
                android:id="@+id/rotateIcon"
                style="@style/OutlineButton"
                android:layout_width="0dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:text="Rotate" />

            <Button
                android:id="@+id/resetIcon"
                style="@style/OutlineButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Reset" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Brightness" />

            <TextView
                android:id="@+id/brightnessValue"
                style="@style/ValueLabel"
                android:text="0" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/brightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Contrast" />

            <TextView
                android:id="@+id/contrastValue"
                style="@style/ValueLabel"
                android:text="100%" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/contrast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Saturation" />

            <TextView
                android:id="@+id/saturationValue"
                style="@style/ValueLabel"
                android:text="100%" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/saturation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            style="@style/FieldLabel"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="6dp"
            android:text="Cover art \u2014 game code or title" />

        <EditText
            android:id="@+id/gameCode"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/field"
            android:hint="CGB-BXTJ-JPN"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/findCover"
            style="@style/OutlineButton"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:text="Find cover art" />

        <TextView
            style="@style/FieldLabel"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="6dp"
            android:text="App name" />

        <EditText
            android:id="@+id/appName"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/field"
            android:hint="Pokemon Crystal"
            android:inputType="textCapWords"
            android:maxLength="50"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            style="@style/FieldLabel"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Package ID" />

        <EditText
            android:id="@+id/packageId"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/field"
            android:fontFamily="monospace"
            android:hint="com.fixmylife.rom.mygame"
            android:inputType="textNoSuggestions|textVisiblePassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Used for installation and app identification. Unique per game."
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/build"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/pill_primary"
            android:enabled="false"
            android:stateListAnimator="@null"
            android:text="Create installable app"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_muted"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/install"
                style="@style/OutlineButton"
                android:layout_width="0dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="Install" />

            <Button
                android:id="@+id/save"
                style="@style/OutlineButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="Save APK" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
